{
  "name": "ymir",
  "version": "0.1.0",
  "private": true,
  "description": "6-DOF naval physics simulator — rigid-body hydrodynamics for ships and floating platforms under current, wind, waves, thrusters, rudders, and tug interactions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinihcrosa/Ymir.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build:wasm": "turbo run build:wasm",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
