{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build:wasm": {
      "outputs": ["runtime/**"],
      "inputs": [
        "scripts/build-wasm.sh",
        "$TURBO_ROOT$/core/**/*.cpp",
        "$TURBO_ROOT$/core/**/*.h",
        "$TURBO_ROOT$/core/**/*.hpp",
        "$TURBO_ROOT$/core/CMakeLists.wasm.txt",
        "$TURBO_ROOT$/core/cmake/**"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build:wasm", "^build:wasm"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
